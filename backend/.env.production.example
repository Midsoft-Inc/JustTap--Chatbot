NODE_ENV=production
CHATBOT_MODE=production
PORT=8080
HOST=0.0.0.0

# Set this to the production frontend origin(s), comma-separated if needed.
CORS_ORIGIN=https://app.example.com

# Production database -- set real secrets only on the backend host.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=justtap_chatbot

QDRANT_URL=https://YOUR-QDRANT-ENDPOINT
QDRANT_API_KEY=REPLACE_ON_SERVER
QDRANT_COLLECTION=justtap_knowledge
VECTOR_SIZE=384

HF_API_TOKEN=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
HF_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
HF_LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct


ADMIN_TOKEN=REPLACE_WITH_LONG_RANDOM_SERVER_SECRET
