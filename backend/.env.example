NODE_ENV=production
CHATBOT_MODE=production
CORS_ORIGIN=*
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB=justtap_chatbot
MONGODB_VECTOR_INDEX=knowledge_vector_index
VECTOR_SIZE=384
HF_API_TOKEN=<your-new-huggingface-token>
HF_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
HF_LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_RERANKER_MODEL=<your-reranker-model-id-if-used>
TOP_K_VECTOR=12
TOP_K_KEYWORD=12
TOP_K_FINAL=5
MIN_RELEVANCE_SCORE=0.52
TICKET_CONFIDENCE_THRESHOLD=0.55
ADMIN_TOKEN=<generate-a-new-long-random-token>
